# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Intermediate files of the analysis pipeline: the per-split batches written by
# the per-dataset loaders, and the consolidated corpus that utils/merge.py
# builds from them. Both are large and can be rebuilt from Datas/ at any time,
# so the repository keeps only the input corpora and the final results.
Datas/*/eval/train_output*.json
Datas/*/eval/test_output*.json
Datas/*/eval/validation_output*.json
Datas/*/eval/eval_output_data.json
Datas/*/eval/train_data.json
Datas/*/eval/test_data.json
Datas/*/eval/output_data.json
Datas/*/eval/*_merge_output.json
